# Cloudflare Pages response headers. Cloudflare's format: a path pattern, then
# indented `Header: value` lines. Documented limits are 100 header rules and
# 2,000 characters per line; this file uses 4 rules.
#
# There is deliberately NO Access-Control-Allow-Origin header anywhere in this
# file. Nothing on this origin serves an API, so its ABSENCE is the security
# property — do not add one "for completeness".

/*
  # Report-only first: violations appear in the devtools console without
  # breaking anything. After the first deploy, confirm the console is clean,
  # then comment this line out and uncomment the enforcing header below. The
  # two carry an identical policy.
  Content-Security-Policy-Report-Only: default-src 'none'; script-src 'self'; style-src 'self'; img-src 'self'; font-src 'self'; connect-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'; object-src 'none'; upgrade-insecure-requests
  # Uncomment this (and comment out the report-only line above) once the
  # deployed site reports zero violations.
  # Content-Security-Policy: default-src 'none'; script-src 'self'; style-src 'self'; img-src 'self'; font-src 'self'; connect-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'; object-src 'none'; upgrade-insecure-requests
  #
  # connect-src is 'none', not 'self': this app makes no network request of any
  # kind. `grep -rnE "fetch\(|XMLHttpRequest|WebSocket|sendBeacon" src` is
  # empty, and progress lives only in localStorage. Once the enforcing header
  # is switched on, "nothing is transmitted" stops being a promise in the
  # README and becomes something the browser enforces.
  #
  # BEFORE ENFORCING, check one thing: the progress Export button builds a
  # `blob:` URL (URL.createObjectURL in ProgressTransfer.tsx) and clicks an
  # <a download>. Verify that export still saves a file under the enforcing
  # policy; if a browser blocks the blob navigation, the fix is to allow
  # `blob:` in the relevant directive, NOT to loosen connect-src.
  #
  # img-src has no `data:`: there are no data: URIs in the app. The favicon is
  # a served file and every illustration is inline JSX SVG covered by
  # default-src. There are no external fonts, scripts or stylesheets at all.
  #
  # No `preload` on HSTS: on a *.pages.dev subdomain the preload decision is
  # Cloudflare's, not ours. Add it only with a custom apex we own.
  Strict-Transport-Security: max-age=63072000; includeSubDomains
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer
  Permissions-Policy: accelerometer=(), camera=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), payment=(), usb=()
  # frame-ancestors above is the real anti-framing control; this is for anything
  # that does not implement CSP3.
  X-Frame-Options: DENY
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Resource-Policy: same-origin

# Hashed filenames, so the content can never change under a given URL.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

/index.html
  Cache-Control: no-cache

# Lab artifacts never change under a given filename (a rebuilt lab ships under
# a new name), so they cache like assets.
# Deliberately no Content-Disposition or Content-Type here: Cloudflare's
# _headers documentation does not state that those are honoured, and the
# download is driven by the <a download> attribute instead, which is verified
# in a browser before a lab ships.
/labs/*
  Cache-Control: public, max-age=31536000, immutable
